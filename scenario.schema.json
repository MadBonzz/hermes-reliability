{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HermesMultiTurnEvalScenario",
  "type": "object",
  "required": [
    "id",
    "name",
    "property_tested",
    "turns"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "property_tested": {
      "type": "string"
    },
    "mock_tools": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "parameters",
          "behavior"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "behavior": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "state_append_and_optional_error",
                  "state_kv_write_and_optional_error",
                  "unverified_race_deduct",
                  "static_return",
                  "stateful_service"
                ]
              },
              "target_file": {
                "type": "string"
              },
              "delay_ms": {
                "type": "integer",
                "default": 0,
                "minimum": 0
              },
              "return_payload": {},
              "error_when_flag_set": {
                "type": "string"
              },
              "error_message": {
                "type": "string"
              },
              "fail_before_write": {
                "type": "boolean",
                "default": false
              },
              "clear_flag_after_first_error": {
                "type": "boolean",
                "default": false
              },
              "read_target_file": {
                "type": "boolean",
                "default": false
              },
              "service": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "operation": {
                "enum": [
                  "read",
                  "lookup",
                  "transition",
                  "compare_and_swap",
                  "append",
                  "idempotent_append"
                ]
              },
              "initial_state": {
                "type": "object"
              },
              "requires": {
                "type": "object"
              },
              "updates": {
                "type": "object"
              },
              "rejection": {
                "type": "object"
              },
              "transient_failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "failure_response": {
                "type": "object"
              },
              "lookup_arg": {
                "type": "string"
              },
              "responses": {
                "type": "object"
              },
              "idempotency_field": {
                "type": "string"
              },
              "receipt_prefix": {
                "type": "string",
                "minLength": 1
              },
              "requires_arguments": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "receipt_prefix"
                  ]
                },
                "then": {
                  "required": [
                    "operation"
                  ],
                  "properties": {
                    "type": {
                      "const": "stateful_service"
                    },
                    "operation": {
                      "const": "idempotent_append"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "stateful_service"
                    }
                  }
                },
                "then": {
                  "required": [
                    "service",
                    "operation"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "stateful_service"
                    },
                    "operation": {
                      "const": "lookup"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "lookup_arg",
                    "responses"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "stateful_service"
                    },
                    "operation": {
                      "const": "idempotent_append"
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "required": [
                    "idempotency_field"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "transient_failures"
                  ]
                },
                "then": {
                  "required": [
                    "failure_response"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "stateful_service"
                    },
                    "operation": {
                      "enum": [
                        "read",
                        "lookup"
                      ]
                    }
                  },
                  "required": [
                    "operation"
                  ]
                },
                "then": {
                  "properties": {
                    "fail_before_write": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "turn_number",
          "prompt",
          "state_checks",
          "process_checks",
          "output_checks"
        ],
        "properties": {
          "turn_number": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "pre_turn_perturbations": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "write_file",
                    "append_file",
                    "delete_file",
                    "chmod",
                    "mkdir",
                    "set_fault_flag",
                    "compress_context",
                    "truncate_history",
                    "set_mock_state"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "flag_name": {
                  "type": "string"
                },
                "flag_value": {
                  "type": "boolean"
                },
                "keep_last_n_messages": {
                  "type": "integer",
                  "minimum": 0
                },
                "use_native_compressor": {
                  "type": "boolean",
                  "default": false
                },
                "service": {
                  "type": "string"
                },
                "values": {
                  "type": "object"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "write_file",
                          "append_file"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "content"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "delete_file",
                          "mkdir"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "chmod"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "mode"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "set_fault_flag"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "flag_name"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "set_mock_state"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "service",
                      "values"
                    ]
                  }
                }
              ]
            }
          },
          "post_turn_cleanup": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "chmod",
                    "set_fault_flag",
                    "set_mock_state"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "flag_name": {
                  "type": "string"
                },
                "flag_value": {
                  "type": "boolean"
                },
                "service": {
                  "type": "string"
                },
                "values": {
                  "type": "object"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "chmod"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "mode"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "set_fault_flag"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "flag_name"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "set_mock_state"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "service",
                      "values"
                    ]
                  }
                }
              ]
            }
          },
          "state_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "file_exists",
                    "file_not_exists",
                    "file_contains",
                    "file_not_contains",
                    "file_exact_lines",
                    "file_line_count",
                    "file_substring_count",
                    "json_path_equals",
                    "json_valid",
                    "json_key_count",
                    "json_equals",
                    "json_array_unordered",
                    "file_sha256",
                    "directory_files",
                    "mock_state_equals",
                    "mock_effects_equal",
                    "mock_state_contains",
                    "mock_state_not_contains",
                    "python_syntax",
                    "mock_array_unordered",
                    "mock_text_matches_file",
                    "mock_json_matches_file",
                    "csv_rows_equal",
                    "python_ast_equals"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "json_path": {
                  "type": "string"
                },
                "substring": {
                  "type": "string"
                },
                "expected": {},
                "numeric_columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "file_json_path": {
                  "type": "string"
                },
                "file_version": {
                  "enum": [
                    "before_turn",
                    "after_turn"
                  ]
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "file_exists",
                          "file_not_exists",
                          "json_valid",
                          "python_syntax"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "file_contains",
                          "file_not_contains",
                          "file_exact_lines",
                          "file_line_count",
                          "json_key_count"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "expected"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "file_substring_count"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "substring",
                      "expected"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "json_path_equals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "json_path",
                      "expected"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "json_equals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "expected",
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "json_array_unordered"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "expected": {
                        "type": "array"
                      }
                    },
                    "required": [
                      "expected",
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "file_sha256"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "expected": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "expected",
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "directory_files"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "expected": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "expected",
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "mock_state_equals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "expected",
                      "json_path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "mock_effects_equal"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "expected": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "expected"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "mock_state_contains",
                          "mock_state_not_contains"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "json_path",
                      "expected"
                    ],
                    "properties": {
                      "expected": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "mock_array_unordered"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "json_path",
                      "expected"
                    ],
                    "properties": {
                      "expected": {
                        "type": "array"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "mock_text_matches_file",
                          "mock_json_matches_file"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "json_path",
                      "path"
                    ],
                    "properties": {}
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "mock_json_matches_file"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "file_json_path"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "file_json_path"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "mock_json_matches_file"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "file_version"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "mock_text_matches_file"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "csv_rows_equal"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "expected"
                    ],
                    "properties": {
                      "expected": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "python_ast_equals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path",
                      "expected"
                    ],
                    "properties": {
                      "expected": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          },
          "process_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "min_total_tool_calls",
                    "max_total_tool_calls",
                    "tool_called",
                    "tool_not_called",
                    "any_tool_called",
                    "tool_call_count_equals",
                    "tool_called_before",
                    "tool_called_after_last",
                    "arguments_not_contain",
                    "min_tool_call_count"
                  ]
                },
                "tool_name": {
                  "type": "string"
                },
                "first_tool": {
                  "type": "string"
                },
                "second_tool": {
                  "type": "string"
                },
                "after_tool": {
                  "type": "string"
                },
                "tool_names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "forbidden_substring": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "min_total_tool_calls",
                          "max_total_tool_calls"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "count"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "tool_called",
                          "tool_not_called"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "tool_name"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "any_tool_called"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "tool_names"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "tool_call_count_equals",
                          "min_tool_call_count"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "tool_name",
                      "count"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "tool_called_before"
                      }
                    }
                  },
                  "then": {
                    "description": "Require a first_tool call followed by a second_tool call at a later position; earlier preflight calls are allowed.",
                    "required": [
                      "first_tool",
                      "second_tool"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "arguments_not_contain"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "forbidden_substring"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "tool_called_after_last"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "tool_name",
                      "after_tool"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "after_tool"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "tool_called_after_last"
                      }
                    }
                  }
                }
              ]
            }
          },
          "output_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "contains_any",
                    "contains_all",
                    "not_contains",
                    "regex_match",
                    "json_answer"
                  ]
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "pattern": {
                  "type": "string"
                },
                "expected": {},
                "json_path": {
                  "type": "string"
                },
                "unordered": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "contains_any",
                          "contains_all",
                          "not_contains"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "values"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "regex_match"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "pattern"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "json_answer"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "expected"
                    ]
                  }
                }
              ]
            }
          },
          "reference": {
            "type": "object",
            "required": [
              "actions",
              "final_response"
            ],
            "additionalProperties": false,
            "properties": {
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "tool",
                    "arguments"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "tool": {
                      "type": "string"
                    },
                    "arguments": {
                      "type": "object"
                    }
                  }
                }
              },
              "final_response": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
