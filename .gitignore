# Local configuration (may contain credentials).
.env
.env.*
!.env.example

# Local evaluation evidence: reports, traces, correlated requests, diagnostics,
# and retained task workspaces. Authored inputs live in /scenarios/ instead.
/eval_harness/

# Common alternative destinations for --output, --workspace-root, or log exports.
/results/
/workspaces/
/eval_workspace/
/traces/
/logs/
/matched_requests/
/eval_report.json
*.log

# Python runtime artifacts.
__pycache__/
*.py[cod]
.venv/
.uv-cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Test/coverage output and operating-system metadata.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.DS_Store
Thumbs.db
