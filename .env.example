# Copy to .env in the repository root. Values are literal, with no ${...} expansion.
# Dashboard defaults: Muse Wonder for orchestration/review, Muse Spark Contributor for tasks.
META_KEY=your-meta-api-key

# Optional local or general API connection for the dashboard.
# LOCAL_API_KEY=local
# PROVIDER_API_KEY=your-provider-key

# Optional dataset discovery access. Public catalogues work without a search API key.
# HF_TOKEN=your-hugging-face-token

# Direct benchmark CLI configuration. Supply the API root, ending in /v1.
# HERMES_AGENT_ROOT=/path/to/hermes-agent
# EVAL_BASE_URL=http://localhost:1235/v1
# EVAL_MODEL=your-exact-loaded-model-id
# EVAL_API_KEY=local

# Meta example for the direct benchmark CLI.
# EVAL_BASE_URL=https://api.meta.ai/v1
# EVAL_MODEL=muse-spark-1.3-contributor
# EVAL_API_KEY=your-meta-api-key

# Ollama example.
# EVAL_BASE_URL=http://localhost:11434/v1
# EVAL_MODEL=your-tool-capable-model-tag
# EVAL_API_KEY=local

# Precedence: CLI arguments > shell environment > repository .env > defaults.
# Hermes runtime Python is configured separately from HERMES_AGENT_ROOT.
