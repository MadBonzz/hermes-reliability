# Copy this file to .env in the repository root and edit for your installation.
# Activate the Hermes Python environment separately; .env does not select Python.
# Use an absolute path to the Hermes checkout containing run_agent.py.
# HERMES_AGENT_ROOT=/path/to/hermes-agent
# Windows example (forward slashes avoid backslash escaping):
# HERMES_AGENT_ROOT=C:/Users/your-name/path/to/hermes/workspace

# LM Studio: use the URL shown by your server, including /v1.
EVAL_BASE_URL=http://localhost:1235/v1
EVAL_MODEL=nvidia/nemotron-3-nano-4b
# For Ollama, replace the two values above with:
# EVAL_BASE_URL=http://localhost:11434/v1
# EVAL_MODEL=qwen3:8b
# Use the exact model name from `ollama list`; the model must support tools.
# Set only if your server requires a key. Local Ollama ignores this value.
# EVAL_API_KEY=your-local-server-key

# Hosted example: replace EVAL_BASE_URL, EVAL_MODEL, and EVAL_API_KEY above.
# EVAL_BASE_URL=https://openrouter.ai/api/v1
# EVAL_MODEL=meta-llama/llama-3.3-70b-instruct
# EVAL_API_KEY=your-provider-api-key
# Any provider supporting Chat Completions with tools can use the same settings.
# API exchanges are captured automatically under eval_harness/results/runs/.

# Precedence: CLI arguments > shell environment > .env > built-in defaults.
# Values are literal: ${VARIABLE} interpolation is intentionally disabled.
# Legacy LM_STUDIO_URL / LM_STUDIO_API_KEY remain supported. Generic EVAL_ names
# win within the same layer; shell values always override .env values.
