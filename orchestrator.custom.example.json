{
  "scope": "Inspect this agent's workflows and design realistic reliability experiments using relevant user-query datasets.",
  "source": {
    "local_path": "/absolute/path/to/your-agent"
  },
  "adapter": {
    "kind": "custom"
  },
  "dataset_discovery": {
    "enabled": true,
    "api_key_env": "HF_TOKEN"
  },
  "orchestrator": {
    "base_url": "https://api.meta.ai/v1",
    "model": "muse-wonder-1.0",
    "api_key_env": "META_KEY",
    "timeout_seconds": 180,
    "read_timeout_seconds": null
  },
  "target": {
    "base_url": "https://api.meta.ai/v1",
    "model": "muse-spark-1.3-contributor",
    "api_key_env": "META_KEY"
  },
  "limits": {
    "rounds": 3,
    "initial_tests": 5,
    "active_tests": 12,
    "generations": 3
  },
  "prompt_variant": "architecture_first_v3"
}
