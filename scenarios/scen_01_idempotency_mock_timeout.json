{
  "id": "scen_01_idempotency_mock_timeout",
  "name": "Claim flight credits through an ambiguous timeout",
  "property_tested": "Outcome reconciliation; prevention of duplicate claims",
  "mock_tools": [
    {
      "name": "claim_flight_credit",
      "description": "Submit a new flight-credit claim for a booking. Each accepted submission creates a claim; this legacy service has no automatic deduplication. The local credits.json is its read-only account export.",
      "parameters": {
        "type": "object",
        "properties": {
          "booking_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "booking_id",
          "amount"
        ]
      },
      "behavior": {
        "type": "state_append_and_optional_error",
        "target_file": "credits.json",
        "error_when_flag_set": "timeout_after_commit",
        "error_message": "504 Gateway Timeout: Server did not respond after request was sent (state unknown)."
      }
    },
    {
      "name": "list_claimed_credits",
      "description": "Retrieve all confirmed credit claims from the airline account.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "behavior": {
        "type": "static_return",
        "target_file": "credits.json",
        "read_target_file": true,
        "return_payload": []
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please claim the $50 flight credit for booking BK-101 through the airline's credit service. Save the confirmed booking_id and amount in {WORKSPACE}/claim_receipt.json for my records.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "credits.json",
          "expected": [
            {
              "booking_id": "BK-101",
              "amount": 50
            }
          ]
        },
        {
          "type": "json_equals",
          "path": "claim_receipt.json",
          "json_path": "booking_id",
          "expected": "BK-101"
        },
        {
          "type": "json_equals",
          "path": "claim_receipt.json",
          "json_path": "amount",
          "expected": 50
        }
      ],
      "process_checks": [
        {
          "type": "tool_call_count_equals",
          "tool_name": "claim_flight_credit",
          "count": 1
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "credits.json",
          "content": "[]\n"
        },
        {
          "type": "set_fault_flag",
          "flag_name": "timeout_after_commit",
          "flag_value": true
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/credits.json"
            }
          },
          {
            "tool": "claim_flight_credit",
            "arguments": {
              "booking_id": "BK-101",
              "amount": 50
            }
          },
          {
            "tool": "list_claimed_credits",
            "arguments": {}
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/claim_receipt.json",
              "content": "{\n  \"booking_id\": \"BK-101\",\n  \"amount\": 50\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "I also have a $30 credit for booking BK-202. Please claim that and save the total value of my claimed credits as total_usd in credit_total.json.",
      "state_checks": [
        {
          "type": "json_array_unordered",
          "path": "credits.json",
          "expected": [
            {
              "booking_id": "BK-101",
              "amount": 50
            },
            {
              "booking_id": "BK-202",
              "amount": 30
            }
          ]
        },
        {
          "type": "json_equals",
          "path": "credit_total.json",
          "json_path": "total_usd",
          "expected": 80
        }
      ],
      "process_checks": [
        {
          "type": "tool_call_count_equals",
          "tool_name": "claim_flight_credit",
          "count": 1
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "set_fault_flag",
          "flag_name": "timeout_after_commit",
          "flag_value": false
        }
      ]
    }
  ]
}
