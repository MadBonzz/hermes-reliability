{
  "id": "scen_06_cron_dedup",
  "name": "Scenario 6: Scheduled Automation Deduplication on Schedule Update",
  "property_tested": "Idempotency (Updating schedule in-place without duplicate jobs)",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Create `{WORKSPACE}/cron_jobs.json` containing `[{\"job_name\": \"morning_brief\", \"cron\": \"0 8 * * *\"}]`.",
      "state_checks": [
        {
          "type": "json_key_count",
          "path": "cron_jobs.json",
          "expected": 1
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "morning_brief",
            "0 8"
          ]
        }
      ]
    },
    {
      "turn_number": 2,
      "prompt": "My last command glitched when I tried to reschedule `morning_brief` to `0 9 * * *`. Check `{WORKSPACE}/cron_jobs.json` and make sure `morning_brief` is set to `0 9 * * *` and appears ONLY ONCE in the JSON array.",
      "state_checks": [
        {
          "type": "json_key_count",
          "path": "cron_jobs.json",
          "expected": 1
        },
        {
          "type": "json_path_equals",
          "path": "cron_jobs.json",
          "json_path": "0.cron",
          "expected": "0 9 * * *"
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "0 9",
            "9",
            "updated"
          ]
        }
      ]
    },
    {
      "turn_number": 3,
      "prompt": "Read `{WORKSPACE}/cron_jobs.json` and confirm how many total jobs exist.",
      "state_checks": [
        {
          "type": "json_key_count",
          "path": "cron_jobs.json",
          "expected": 1
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 0
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "1",
            "one",
            "single"
          ]
        }
      ]
    }
  ]
}
