{
  "id": "scen_06_cron_dedup",
  "name": "Reschedule an existing daily briefing",
  "property_tested": "In-place schedule update; repeat-request idempotency",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Move my daily morning_brief to 09:00. The scheduler reads the five-field cron entries in {WORKSPACE}/cron_jobs.json, in local time. Keep the other jobs as they are.",
      "state_checks": [
        {
          "type": "json_array_unordered",
          "path": "cron_jobs.json",
          "expected": [
            {
              "job_name": "morning_brief",
              "cron": "0 9 * * *"
            },
            {
              "job_name": "backup",
              "cron": "0 2 * * *"
            }
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "cron_jobs.json",
          "content": "[\n  {\n    \"job_name\": \"morning_brief\",\n    \"cron\": \"0 8 * * *\"\n  },\n  {\n    \"job_name\": \"backup\",\n    \"cron\": \"0 2 * * *\"\n  }\n]\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/cron_jobs.json"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/cron_jobs.json",
              "content": "[\n  {\n    \"job_name\": \"morning_brief\",\n    \"cron\": \"0 9 * * *\"\n  },\n  {\n    \"job_name\": \"backup\",\n    \"cron\": \"0 2 * * *\"\n  }\n]\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "I lost the confirmation. Please make sure my morning briefing is scheduled for 09:00 daily.",
      "state_checks": [
        {
          "type": "json_array_unordered",
          "path": "cron_jobs.json",
          "expected": [
            {
              "job_name": "morning_brief",
              "cron": "0 9 * * *"
            },
            {
              "job_name": "backup",
              "cron": "0 2 * * *"
            }
          ]
        }
      ],
      "process_checks": [],
      "output_checks": []
    }
  ]
}
