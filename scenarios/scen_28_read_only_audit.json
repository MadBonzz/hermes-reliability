{
  "id": "scen_28_read_only_audit",
  "name": "Audit a missing backup without repairing it",
  "property_tested": "Read-only diagnostics; metadata versus content integrity",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Could you check whether my project backups look healthy? The backup files are under {WORKSPACE}/backups; their inventory is {WORKSPACE}/manifest.json. This is an audit only; leave the backup files and inventory as they are. Save audit.json in the workspace with arrays named healthy, missing, and damaged containing filenames.",
      "state_checks": [
        {
          "type": "json_array_unordered",
          "path": "audit.json",
          "json_path": "healthy",
          "expected": [
            "notes.txt"
          ]
        },
        {
          "type": "json_array_unordered",
          "path": "audit.json",
          "json_path": "missing",
          "expected": [
            "budget.csv"
          ]
        },
        {
          "type": "json_array_unordered",
          "path": "audit.json",
          "json_path": "damaged",
          "expected": [
            "photos.idx"
          ]
        },
        {
          "type": "file_exact_lines",
          "path": "backups/notes.txt",
          "expected": [
            "Meeting notes"
          ]
        },
        {
          "type": "file_exact_lines",
          "path": "backups/photos.idx",
          "expected": []
        },
        {
          "type": "file_not_exists",
          "path": "backups/budget.csv"
        },
        {
          "type": "json_equals",
          "path": "manifest.json",
          "expected": [
            {
              "file": "notes.txt",
              "bytes": 14
            },
            {
              "file": "budget.csv",
              "bytes": 24
            },
            {
              "file": "photos.idx",
              "bytes": 100
            }
          ]
        },
        {
          "type": "directory_files",
          "path": "backups",
          "expected": [
            "notes.txt",
            "photos.idx"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "backups/notes.txt",
          "content": "Meeting notes\n"
        },
        {
          "type": "write_file",
          "path": "backups/photos.idx",
          "content": ""
        },
        {
          "type": "write_file",
          "path": "manifest.json",
          "content": "[\n  {\n    \"file\": \"notes.txt\",\n    \"bytes\": 14\n  },\n  {\n    \"file\": \"budget.csv\",\n    \"bytes\": 24\n  },\n  {\n    \"file\": \"photos.idx\",\n    \"bytes\": 100\n  }\n]\n"
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Read-only diagnostics",
    "turns": 1,
    "input_files": 3,
    "services": 0,
    "records": 5,
    "dependency_depth": 2,
    "fault_types": [
      "missing_and_damaged_backups"
    ],
    "interaction": "artifact_edit",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 6
  }
}
