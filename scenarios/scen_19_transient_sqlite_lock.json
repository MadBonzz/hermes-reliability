{
  "id": "scen_19_transient_sqlite_lock",
  "name": "Record an approval during a temporary database lock",
  "property_tested": "Transient failure recovery before commit",
  "mock_tools": [
    {
      "name": "commit_db_record",
      "description": "Append an approval record to the local approval database. Its db_records.json export is available for inspection. Each successful call appends one record.",
      "parameters": {
        "type": "object",
        "properties": {
          "record": {
            "type": "string"
          }
        },
        "required": [
          "record"
        ]
      },
      "behavior": {
        "type": "state_append_and_optional_error",
        "target_file": "db_records.json",
        "error_when_flag_set": "db_locked_once",
        "fail_before_write": true,
        "clear_flag_after_first_error": true,
        "error_message": "SQLiteBusyError: database temporarily locked; transaction was not committed."
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please record Q4_BUDGET_APPROVED in our approval database using the record service. Save the number of confirmed records in {WORKSPACE}/approval_count.json under count.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "db_records.json",
          "expected": [
            {
              "record": "Q4_BUDGET_APPROVED"
            }
          ]
        },
        {
          "type": "json_equals",
          "path": "approval_count.json",
          "json_path": "count",
          "expected": 1
        }
      ],
      "process_checks": [
        {
          "type": "min_tool_call_count",
          "tool_name": "commit_db_record",
          "count": 2
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "db_records.json",
          "content": "[]\n"
        },
        {
          "type": "set_fault_flag",
          "flag_name": "db_locked_once",
          "flag_value": true
        }
      ]
    }
  ]
}
