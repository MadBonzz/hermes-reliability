{
  "id": "scen_19_transient_sqlite_lock",
  "name": "Scenario 19: Transient Database Lock Recovery (SQLiteBusyError on 1st Attempt)",
  "property_tested": "Fault Tolerance (Retrying transient lock error once without duplicating)",
  "mock_tools": [
    {
      "name": "commit_db_record",
      "description": "Writes a record to db_records.json. May return transient SQLiteBusyError if locked.",
      "parameters": {
        "type": "object",
        "properties": {
          "record": {
            "type": "string"
          }
        },
        "required": [
          "record"
        ]
      },
      "behavior": {
        "type": "state_append_and_optional_error",
        "target_file": "db_records.json",
        "error_when_flag_set": "db_locked_once",
        "fail_before_write": true,
        "clear_flag_after_first_error": true,
        "error_message": "SQLiteBusyError: database is temporarily locked (0 rows written, safe to retry)."
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Initialize `{WORKSPACE}/db_records.json` with an empty JSON array `[]`.",
      "state_checks": [
        {
          "type": "json_key_count",
          "path": "db_records.json",
          "expected": 0
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "db_records.json",
            "empty",
            "initialized"
          ]
        }
      ]
    },
    {
      "turn_number": 2,
      "prompt": "Use `commit_db_record` to save `'Q4_BUDGET_APPROVED'`. If it returns `SQLiteBusyError` (0 rows written), retry `commit_db_record` once so the record is saved.",
      "pre_turn_perturbations": [
        {
          "type": "set_fault_flag",
          "flag_name": "db_locked_once",
          "flag_value": true
        }
      ],
      "state_checks": [
        {
          "type": "json_key_count",
          "path": "db_records.json",
          "expected": 1
        },
        {
          "type": "json_path_equals",
          "path": "db_records.json",
          "json_path": "0.record",
          "expected": "Q4_BUDGET_APPROVED"
        }
      ],
      "process_checks": [
        {
          "type": "tool_call_count_equals",
          "tool_name": "commit_db_record",
          "count": 2
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "q4_budget_approved",
            "saved",
            "committed",
            "retried"
          ]
        }
      ]
    },
    {
      "turn_number": 3,
      "prompt": "Read `{WORKSPACE}/db_records.json` and confirm how many records are stored.",
      "state_checks": [
        {
          "type": "json_key_count",
          "path": "db_records.json",
          "expected": 1
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 0
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "1",
            "one"
          ]
        }
      ]
    }
  ]
}
