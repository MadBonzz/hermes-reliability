{
  "id": "scen_44_accepted_revision_recovery",
  "name": "Keep an accepted revision when a later import fails",
  "property_tested": "Partial rollback boundary; preservation of previously accepted work",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "The catalog is in {WORKSPACE}/catalog.json. Change the shop name to 'Harbor Books'; this correction is approved.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "catalog.json",
          "expected": {
            "shop": "Harbor Books",
            "items": [
              {
                "id": "B1",
                "price": 12
              }
            ]
          }
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "catalog.json",
          "content": "{\n  \"shop\": \"Harbour Books\",\n  \"items\": [\n    {\n      \"id\": \"B1\",\n      \"price\": 12\n    }\n  ]\n}\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/catalog.json"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/catalog.json",
              "content": "{\n  \"shop\": \"Harbor Books\",\n  \"items\": [\n    {\n      \"id\": \"B1\",\n      \"price\": 12\n    }\n  ]\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Import the new items from delivery.json into the catalog. A delivery is an all-or-nothing batch, and every item needs a nonnegative numeric price. If the delivery is invalid, keep the accepted catalog and put the offending item IDs in rejected.json as a JSON array.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "catalog.json",
          "expected": {
            "shop": "Harbor Books",
            "items": [
              {
                "id": "B1",
                "price": 12
              }
            ]
          }
        },
        {
          "type": "json_array_unordered",
          "path": "rejected.json",
          "expected": [
            "B3"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "delivery.json",
          "content": "[\n  {\n    \"id\": \"B2\",\n    \"price\": 15\n  },\n  {\n    \"id\": \"B3\",\n    \"price\": \"unknown\"\n  }\n]\n"
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Partial rollback boundary",
