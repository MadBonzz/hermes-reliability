{
  "id": "scen_52_bounded_queue_backpressure",
  "name": "Submit a job when completed results fill the queue",
  "property_tested": "Capacity backpressure; protocol recovery rather than timed rate limiting",
  "mock_tools": [
    {
      "name": "enqueue_export",
      "description": "Submit a report export. A full queue rejects the request without accepting it. The accepted response includes job_id.",
      "parameters": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "report": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "job_id",
          "report"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "export_queue",
        "operation": "transition",
        "initial_state": {
          "free_slot": false,
          "accepted_job": null
        },
        "requires": {
          "free_slot": true
        },
        "rejection": {
          "status": "error",
          "code": "QUEUE_FULL",
          "completed_result_ids": [
            "OLD-4"
          ]
        },
        "updates": {
          "free_slot": false,
          "accepted_job": {
            "$arg": "job_id"
          },
          "report": {
            "$arg": "report"
          }
        },
        "return_payload": {
          "status": "accepted",
          "job_id": {
            "$arg": "job_id"
          }
        }
      }
    },
    {
      "name": "acknowledge_completed_exports",
      "description": "Acknowledge a completed result by result_id, releasing its queue slot. This does not cancel running jobs.",
      "parameters": {
        "type": "object",
        "properties": {
          "result_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "result_id"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "export_queue",
        "operation": "transition",
        "requires": {
          "free_slot": false,
          "accepted_job": null
        },
        "updates": {
          "free_slot": true
        },
        "requires_arguments": {
          "result_id": "OLD-4"
        },
        "rejection": {
          "status": "error",
          "code": "UNKNOWN_COMPLETED_RESULT"
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Submit export job E9 for report APR-2026 through the export queue. You can acknowledge completed results belonging to this project. Tell me the accepted job ID. Reply with JSON containing accepted_job_id.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.export_queue.accepted_job",
          "expected": "E9"
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "acknowledge_completed_exports",
            "enqueue_export"
          ]
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.export_queue.report",
          "expected": "APR-2026"
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "enqueue_export"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "accepted_job_id",
          "expected": "E9"
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Capacity backpressure",
    "turns": 1,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 3,
    "fault_types": [
      "queue_backpressure"
    ],
    "interaction": "service_action",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 0
  }
}
