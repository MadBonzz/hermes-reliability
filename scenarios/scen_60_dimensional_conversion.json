{
  "id": "scen_60_dimensional_conversion",
  "name": "Convert monitoring values for a dashboard",
  "property_tested": "Unit safety; decimal versus binary scale",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Our dashboard expects latency_seconds, memory_gib, and charge_usd. Convert the measurement in {WORKSPACE}/sample.json into those fields in dashboard_sample.json. The input memory is in MiB, not decimal MB.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "dashboard_sample.json",
          "json_path": "latency_seconds",
          "expected": 1.5
        },
        {
          "type": "json_equals",
          "path": "dashboard_sample.json",
          "json_path": "memory_gib",
          "expected": 1.5
        },
        {
          "type": "json_equals",
          "path": "dashboard_sample.json",
          "json_path": "charge_usd",
          "expected": 12.99
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "sample.json",
          "content": "{\n  \"latency_ms\": 1500,\n  \"memory_mib\": 1536,\n  \"charge_cents\": 1299\n}\n"
        }
      ]
    }
  ]
}
