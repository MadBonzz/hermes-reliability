{
  "id": "scen_17_selective_batch_retry",
  "name": "Complete an interrupted notification batch",
  "property_tested": "Selective batch recovery; file-backed delivery ledger",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Our local notification spool in {WORKSPACE} stopped partway through a batch. Finish the pending deliveries. spool_contract.json explains how this local system records a delivery; batch_status.json and sent_log.txt are its current records.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "batch_status.json",
          "expected": {
            "user_1": "SENT",
            "user_2": "SENT",
            "user_3": "SENT"
          }
        },
        {
          "type": "file_exact_lines",
          "path": "sent_log.txt",
          "expected": [
            "SENT: user_1",
            "SENT: user_2",
            "SENT: user_3"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "batch_status.json",
          "content": "{\n  \"user_1\": \"SENT\",\n  \"user_2\": \"SENT\",\n  \"user_3\": \"FAILED_429\"\n}\n"
        },
        {
          "type": "write_file",
          "path": "sent_log.txt",
          "content": "SENT: user_1\nSENT: user_2\n"
        },
        {
          "type": "write_file",
          "path": "spool_contract.json",
          "content": "{\n  \"delivery_record\": \"SENT: <user_id> appended as one line in sent_log.txt\",\n  \"status_on_delivery\": \"SENT\",\n  \"transport\": \"local file spool only; no email or network access\",\n  \"duplicate_policy\": \"one delivery per user for this batch\"\n}\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/batch_status.json"
            }
          },
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/sent_log.txt"
            }
          },
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/spool_contract.json"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/sent_log.txt",
              "content": "SENT: user_1\nSENT: user_2\nSENT: user_3\n"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/batch_status.json",
              "content": "{\n  \"user_1\": \"SENT\",\n  \"user_2\": \"SENT\",\n  \"user_3\": \"SENT\"\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Has everyone in the batch been handled? Finish any outstanding work. Reply with JSON containing all_delivered as a boolean and outstanding_ids as an array of user IDs.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "batch_status.json",
          "expected": {
            "user_1": "SENT",
            "user_2": "SENT",
            "user_3": "SENT"
          }
        },
        {
          "type": "file_exact_lines",
          "path": "sent_log.txt",
          "expected": [
            "SENT: user_1",
            "SENT: user_2",
            "SENT: user_3"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "all_delivered",
          "expected": true
        },
        {
          "type": "json_answer",
          "json_path": "outstanding_ids",
          "expected": [],
          "unordered": true
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Selective batch recovery",
    "turns": 2,
    "input_files": 3,
    "services": 0,
    "records": 3,
    "dependency_depth": 3,
    "fault_types": [
      "partial_prior_batch"
    ],
    "interaction": "artifact_edit",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 2
  }
}
