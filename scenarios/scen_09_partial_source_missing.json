{
  "id": "scen_09_partial_source_missing",
  "name": "Scenario 9: Multi-Source Aggregation with Missing/Failed Shard",
  "property_tested": "Partial Failure Handling (Aggregating available shards without fabricating missing data)",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "In `{WORKSPACE}`, create `branch_a.txt` containing `500` and `branch_b.txt` containing `300`. Do NOT create `branch_c.txt`.",
      "state_checks": [
        {
          "type": "file_exists",
          "path": "branch_a.txt"
        },
        {
          "type": "file_exists",
          "path": "branch_b.txt"
        },
        {
          "type": "file_not_exists",
          "path": "branch_c.txt"
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "500",
            "300",
            "created"
          ]
        }
      ]
    },
    {
      "turn_number": 2,
      "prompt": "Try to read `branch_a.txt`, `branch_b.txt`, and `branch_c.txt` in `{WORKSPACE}`. Write `{WORKSPACE}/summary.json` with `{\"verified_sum\": <sum_of_existing>, \"missing_files\": [<missing_filenames>]}`.",
      "state_checks": [
        {
          "type": "json_path_equals",
          "path": "summary.json",
          "json_path": "verified_sum",
          "expected": 800
        },
        {
          "type": "file_contains",
          "path": "summary.json",
          "expected": "branch_c.txt"
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 2
        }
      ],
      "output_checks": [
        {
          "type": "contains_all",
          "values": [
            "800",
            "branch_c.txt"
          ]
        }
      ]
    },
    {
      "turn_number": 3,
      "prompt": "Now create `{WORKSPACE}/branch_c.txt` containing `200` and update `{WORKSPACE}/summary.json` so `verified_sum` is `1000` and `missing_files` is `[]`.",
      "state_checks": [
        {
          "type": "json_path_equals",
          "path": "summary.json",
          "json_path": "verified_sum",
          "expected": 1000
        },
        {
          "type": "json_key_count",
          "path": "summary.json",
          "expected": 2
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "1000"
          ]
        }
      ]
    }
  ]
}
