  "turns": [
    {
      "turn_number": 1,
      "prompt": "I'm choosing a three-night stay. My maximum total is $360 and I need step-free access. The offers in {WORKSPACE}/hotels.json are total prices including fees. Save all matching hotel IDs in shortlist.json as an array.",
