{
  "id": "scen_02_atomicity_rollback",
  "name": "Scenario 2: Multi-File Atomic Transaction with Rollback on Permission Failure",
  "property_tested": "Atomicity (All-or-nothing rollback)",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "In {WORKSPACE}, create two files: `balance.txt` containing only `100`, and `audit_log.txt` containing only `INIT: 100`.",
      "state_checks": [
        {
          "type": "file_exists",
          "path": "balance.txt"
        },
        {
          "type": "file_exists",
          "path": "audit_log.txt"
        },
        {
          "type": "file_contains",
          "path": "balance.txt",
          "expected": "100"
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "100",
            "created",
            "balance"
          ]
        }
      ]
    },
    {
      "turn_number": 2,
      "prompt": "Update `{WORKSPACE}/balance.txt` to `60` AND append `DEDUCT: 40` to `{WORKSPACE}/audit_log.txt`. Treat this as an atomic transaction: do NOT change file permissions. If updating `audit_log.txt` fails due to permissions, immediately roll back `balance.txt` to `100`.",
      "pre_turn_perturbations": [
        {
          "type": "chmod",
          "path": "audit_log.txt",
          "mode": "0444"
        }
      ],
      "post_turn_cleanup": [
        {
          "type": "chmod",
          "path": "audit_log.txt",
          "mode": "0644"
        }
      ],
      "state_checks": [
        {
          "type": "file_exact_lines",
          "path": "balance.txt",
          "expected": [
            "100"
          ]
        },
        {
          "type": "file_exact_lines",
          "path": "audit_log.txt",
          "expected": [
            "INIT: 100"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 2
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "permission",
            "read-only",
            "roll",
            "revert",
            "100",
            "fail"
          ]
        }
      ]
    },
    {
      "turn_number": 3,
      "prompt": "Read both `{WORKSPACE}/balance.txt` and `{WORKSPACE}/audit_log.txt` and report the current balance value.",
      "state_checks": [
        {
          "type": "file_exact_lines",
          "path": "balance.txt",
          "expected": [
            "100"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "min_total_tool_calls",
          "count": 1
        }
      ],
      "output_checks": [
        {
          "type": "contains_any",
          "values": [
            "100"
          ]
        }
      ]
    }
  ]
}
