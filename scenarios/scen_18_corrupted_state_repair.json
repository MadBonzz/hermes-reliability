{
  "id": "scen_18_corrupted_state_repair",
  "name": "Recover a damaged application configuration",
  "property_tested": "Evidence-backed corruption repair using a trusted saved configuration",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "The app settings in {WORKSPACE}/config.json are working. Save a copy as last_known_good.json before tomorrow's maintenance.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "config.json",
          "expected": {
            "host": "localhost",
            "port": 8080
          }
        },
        {
          "type": "json_equals",
          "path": "last_known_good.json",
          "expected": {
            "host": "localhost",
            "port": 8080
          }
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "config.json",
          "content": "{\n  \"host\": \"localhost\",\n  \"port\": 8080\n}\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/config.json"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/last_known_good.json",
              "content": "{\n  \"host\": \"localhost\",\n  \"port\": 8080\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "The app no longer starts after maintenance. Please repair config.json to restore the last accepted settings, and add recovered: true so support can identify the repaired configuration.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "config.json",
          "expected": {
            "host": "localhost",
            "port": 8080,
            "recovered": true
          }
        },
        {
          "type": "json_equals",
          "path": "last_known_good.json",
          "expected": {
            "host": "localhost",
            "port": 8080
          }
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "config.json",
          "content": "{\"host\":\"localhost\",\"port\":808"
        }
      ]
    }
  ]
}
