{
  "id": "scen_49_expired_edit_lease",
  "name": "Update inventory after an editing lease expires",
  "property_tested": "Lease validity; recovery from stale edit authority",
  "mock_tools": [
    {
      "name": "get_inventory",
      "description": "Get the inventory count, edit version and lease_valid status.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "inventory",
        "operation": "read",
        "initial_state": {
          "count": 10,
          "version": 1,
          "lease_valid": true
        }
      }
    },
    {
      "name": "renew_inventory_lease",
      "description": "Acquire a new editing lease and return the inventory card with its current version.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "inventory",
        "operation": "transition",
        "requires": {
          "lease_valid": false
        },
        "updates": {
          "lease_valid": true,
          "version": 2
        }
      }
    },
    {
      "name": "update_inventory",
      "description": "Set count under a valid editing lease and matching expected_version. Rejected writes change nothing.",
      "parameters": {
        "type": "object",
        "properties": {
          "expected_version": {
            "type": "integer"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "expected_version",
          "count"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "inventory",
        "operation": "compare_and_swap",
        "requires": {
          "lease_valid": true
        },
        "rejection": {
          "status": "error",
          "code": "LEASE_EXPIRED",
          "message": "The editing lease has expired."
        },
        "updates": {
          "count": {
            "$arg": "count"
          }
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "How many units are in inventory right now? Reply with JSON containing count.",
      "state_checks": [
        {
          "type": "mock_effects_equal",
          "expected": []
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "get_inventory"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "count",
          "expected": 10
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "get_inventory",
            "arguments": {}
          }
        ],
        "final_response": "{\"count\": 10}"
      }
    },
    {
      "turn_number": 2,
      "prompt": "We've received five more units. Update the inventory to include them.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.inventory.count",
          "expected": 15
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.inventory.version",
          "expected": 3
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.inventory.lease_valid",
          "expected": true
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "renew_inventory_lease",
            "update_inventory"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "set_mock_state",
          "service": "inventory",
          "values": {
            "lease_valid": false
          }
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Lease validity",
    "turns": 2,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 3,
    "fault_types": [
      "expired_lease"
    ],
    "interaction": "service_action",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 0
  },
  "experiment": {
    "branch_turn": 2,
    "intervention": "Editing lease expires after inventory review",
    "baseline_turns": [
      {
        "turn_number": 2,
        "prompt": "We've received five more units. Update the inventory to include them.",
        "state_checks": [
          {
            "type": "mock_state_equals",
            "json_path": "services.inventory.count",
            "expected": 15
          },
          {
            "type": "mock_state_equals",
            "json_path": "services.inventory.version",
            "expected": 2
          },
          {
            "type": "mock_state_equals",
            "json_path": "services.inventory.lease_valid",
            "expected": true
          },
          {
            "type": "mock_effects_equal",
            "expected": [
              "update_inventory"
            ]
          }
        ],
        "process_checks": [],
        "output_checks": [],
        "pre_turn_perturbations": []
      }
    ],
    "baseline_complexity": {
      "fault_count": 0,
      "fault_types": []
    }
  }
}
