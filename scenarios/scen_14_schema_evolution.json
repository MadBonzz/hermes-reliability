{
  "id": "scen_14_schema_evolution",
  "name": "Append an email from a changed customer export",
  "property_tested": "Input schema adaptation; preservation of previous output",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please start a mailing list from the customer export in {WORKSPACE}/user_v1.json. Save the email address in emails.txt, one address per line.",
      "state_checks": [
        {
          "type": "file_exact_lines",
          "path": "emails.txt",
          "expected": [
            "alice@example.test"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "user_v1.json",
          "content": "{\n  \"name\": \"Alice\",\n  \"email_address\": \"alice@example.test\"\n}\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/user_v1.json"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/emails.txt",
              "content": "alice@example.test\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Bob's export has arrived in user_v2.json. Please add his email to the same mailing list.",
      "state_checks": [
        {
          "type": "file_exact_lines",
          "path": "emails.txt",
          "expected": [
            "alice@example.test",
            "bob@example.test"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "user_v2.json",
          "content": "{\n  \"full_name\": \"Bob\",\n  \"SchemaVersion\": 2,\n  \"contact\": {\n    \"primary_email\": \"bob@example.test\"\n  }\n}\n"
        }
      ]
    }
  ]
}
