{
  "id": "scen_07_skill_cache_invalidation",
  "name": "Update and apply an editorial skill file",
  "property_tested": "Current workspace instruction use; not native skill-cache verification",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Our note-formatting guide is in {WORKSPACE}/SKILL.md. Please format 'Q3 results ready' into formatted_note.txt for the internal preview.",
      "state_checks": [
        {
          "type": "file_exact_lines",
          "path": "formatted_note.txt",
          "expected": [
            "[DRAFT] Q3 results ready"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
