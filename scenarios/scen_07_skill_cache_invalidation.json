        {
          "type": "write_file",
          "path": "SKILL.md",
          "content": "Prefix each formatted note with [DRAFT], followed by one space and the original note text.\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/SKILL.md"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/formatted_note.txt",
