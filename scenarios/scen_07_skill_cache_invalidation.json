          "expected": "[DRAFT]"
        },
        {
          "type": "file_exact_lines",
          "path": "published_note.txt",
          "expected": [
            "[PUBLISHED-2026] Q3 results ready"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/SKILL.md"
            }
          },
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/formatted_note.txt"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/published_note.txt",
              "content": "[PUBLISHED-2026] Q3 results ready\n"
            }
