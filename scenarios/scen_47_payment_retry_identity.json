{
  "id": "scen_47_payment_retry_identity",
  "name": "Pay an invoice despite a lost acknowledgement",
  "property_tested": "Idempotency-key continuity; distinct repeated business intent",
  "mock_tools": [
    {
      "name": "pay_invoice",
      "description": "Pay an invoice. request_id identifies one logical payment across transport retries. Reuse of the same ID and identical parameters returns the original receipt; different parameters under the same ID are rejected. A successful response includes a receipt_id unique to that payment.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "invoice_id": {
            "type": "string",
            "minLength": 1
          },
          "amount_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "request_id",
          "invoice_id",
          "amount_usd"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "payments",
        "operation": "idempotent_append",
        "initial_state": {
          "records": []
        },
        "idempotency_field": "request_id",
        "receipt_prefix": "PAY",
        "error_when_flag_set": "lost_receipt",
        "error_message": "502 Bad Gateway: connection lost while receiving payment acknowledgement; outcome unknown.",
        "fail_before_write": false,
        "clear_flag_after_first_error": true,
        "return_payload": {
          "status": "ok"
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please pay invoice INV-A for $25 using the payment service. Put its confirmed receipt ID in {WORKSPACE}/receipt_a.txt.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.0.invoice_id",
          "expected": "INV-A"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.0.amount_usd",
          "expected": 25
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "pay_invoice"
          ]
        },
        {
          "type": "file_exact_lines",
          "path": "receipt_a.txt",
          "expected": [
            "PAY-000001"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "min_tool_call_count",
          "tool_name": "pay_invoice",
          "count": 2
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "set_fault_flag",
          "flag_name": "lost_receipt",
          "flag_value": true
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "pay_invoice",
            "arguments": {
              "request_id": "invoice-a-payment",
              "invoice_id": "INV-A",
              "amount_usd": 25
            }
          },
          {
            "tool": "pay_invoice",
            "arguments": {
              "request_id": "invoice-a-payment",
              "invoice_id": "INV-A",
              "amount_usd": 25
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/receipt_a.txt",
              "content": "PAY-000001\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Please also pay invoice INV-B for $25 and put its confirmed receipt ID in receipt_b.txt. This is a separate invoice.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.1.invoice_id",
          "expected": "INV-B"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.1.amount_usd",
          "expected": 25
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "pay_invoice",
            "pay_invoice"
          ]
        },
        {
          "type": "file_exact_lines",
          "path": "receipt_b.txt",
          "expected": [
            "PAY-000002"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "pay_invoice"
        }
      ],
      "output_checks": []
    }
  ]
}
