{
  "id": "v2_scen_03_isolation_dual_ledger",
  "name": "Record two expenses against one shared balance",
  "property_tested": "Shared-ledger updates; lost-update exposure without forced overlap",
  "mock_tools": [
    {
      "name": "deduct_personal_expense",
      "description": "Deducts a personal expense amount from ledger.json.",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "amount"
        ]
      },
      "behavior": {
        "type": "unverified_race_deduct",
        "target_file": "ledger.json",
        "delay_ms": 100
      }
    },
    {
      "name": "deduct_business_expense",
      "description": "Deducts a business expense amount from ledger.json.",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "amount"
        ]
      },
      "behavior": {
        "type": "unverified_race_deduct",
        "target_file": "ledger.json",
        "delay_ms": 100
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please record a $20 personal expense and a $30 business expense using their expense services. They share the account shown in {WORKSPACE}/ledger.json. Save the resulting balance and tx_count in expense_summary.json.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "ledger.json",
          "expected": {
            "balance": 50,
            "tx_count": 2
          }
        },
        {
          "type": "json_equals",
          "path": "expense_summary.json",
          "json_path": "balance",
          "expected": 50
        },
        {
          "type": "json_equals",
          "path": "expense_summary.json",
          "json_path": "tx_count",
          "expected": 2
        }
      ],
      "process_checks": [
        {
          "type": "tool_call_count_equals",
          "tool_name": "deduct_personal_expense",
          "count": 1
        },
        {
          "type": "tool_call_count_equals",
          "tool_name": "deduct_business_expense",
          "count": 1
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "ledger.json",
          "content": "{\n  \"balance\": 100,\n  \"tx_count\": 0\n}\n"
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Shared-ledger updates",
    "turns": 1,
    "input_files": 1,
    "services": 2,
    "records": 1,
    "dependency_depth": 3,
    "fault_types": [
      "race_window"
    ],
    "interaction": "mixed",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 2
  }
}
