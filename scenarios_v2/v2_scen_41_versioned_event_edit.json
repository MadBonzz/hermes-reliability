{
  "id": "v2_scen_41_versioned_event_edit",
  "name": "Update a shared event without losing a teammate's edit",
  "property_tested": "Optimistic concurrency and external-state freshness",
  "mock_tools": [
    {
      "name": "get_event",
      "description": "Get the current event object, including its version.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "event",
        "operation": "read",
        "initial_state": {
          "version": 1,
          "room": "Cedar",
          "capacity": 100
        }
      }
    },
    {
      "name": "update_event",
      "description": "Replace room and capacity for this event. expected_version must match its current version; a conflict changes nothing and returns the current object.",
      "parameters": {
        "type": "object",
        "properties": {
          "expected_version": {
            "type": "integer"
          },
          "room": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version",
          "room",
          "capacity"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "event",
        "operation": "compare_and_swap",
        "updates": {
          "room": {
            "$arg": "room"
          },
          "capacity": {
            "$arg": "capacity"
          }
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "What room and capacity do we have for the event? Reply with JSON fields room and capacity.",
      "state_checks": [
        {
          "type": "mock_effects_equal",
          "expected": []
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "get_event"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "room",
          "expected": "Cedar"
        },
        {
          "type": "json_answer",
          "json_path": "capacity",
          "expected": 100
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "get_event",
            "arguments": {}
          }
        ],
        "final_response": "{\"room\": \"Cedar\", \"capacity\": 100}"
      }
    },
    {
      "turn_number": 2,
      "prompt": "Reduce the event capacity to 80.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.event",
          "expected": {
            "version": 3,
            "room": "Maple",
            "capacity": 80
          }
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "update_event"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "update_event"
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "set_mock_state",
          "service": "event",
          "values": {
            "version": 2,
            "room": "Maple"
          }
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Optimistic concurrency and external-state freshness",
    "turns": 2,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 3,
    "fault_types": [
      "external_concurrent_edit"
    ],
    "interaction": "service_action",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 0
  },
  "experiment": {
    "branch_turn": 2,
    "intervention": "External venue edit between review and update",
    "baseline_turns": [
      {
        "turn_number": 2,
        "prompt": "Reduce the event capacity to 80.",
        "state_checks": [
          {
            "type": "mock_state_equals",
            "json_path": "services.event",
            "expected": {
              "version": 2,
              "room": "Cedar",
              "capacity": 80
            }
          },
          {
            "type": "mock_effects_equal",
            "expected": [
              "update_event"
            ]
          }
        ],
        "process_checks": [
          {
            "type": "tool_called",
            "tool_name": "update_event"
          }
        ],
        "output_checks": [],
        "pre_turn_perturbations": []
      }
    ],
    "baseline_complexity": {
      "fault_count": 0,
      "fault_types": []
    }
  }
}
