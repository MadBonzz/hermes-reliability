{
  "id": "v2_scen_45_sales_view_refresh",
  "name": "Keep a sales dashboard consistent with its records",
  "property_tested": "Derived-state maintenance; base and view agreement",
  "turns": [
    {
      "turn_number": 1,
      "prompt": "The sales data is in {WORKSPACE}/sales.csv. Please prepare dashboard.json with transaction_count and total_usd.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "dashboard.json",
          "json_path": "transaction_count",
          "expected": 2
        },
        {
          "type": "json_equals",
          "path": "dashboard.json",
          "json_path": "total_usd",
          "expected": 50
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "sales.csv",
          "content": "sale_id,amount_usd\nS1,20\nS2,30\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/sales.csv"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/dashboard.json",
              "content": "{\n  \"transaction_count\": 2,\n  \"total_usd\": 50\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Another sale came in: S3 for $15. Add it to our sales records and bring the dashboard up to date.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "dashboard.json",
          "json_path": "transaction_count",
          "expected": 3
        },
        {
          "type": "json_equals",
          "path": "dashboard.json",
          "json_path": "total_usd",
          "expected": 65
        },
        {
          "type": "csv_rows_equal",
          "path": "sales.csv",
          "expected": [
            {
              "sale_id": "S1",
              "amount_usd": 20
            },
            {
              "sale_id": "S2",
              "amount_usd": 30
            },
            {
              "sale_id": "S3",
              "amount_usd": 15
            }
          ],
          "numeric_columns": [
            "amount_usd"
          ]
        }
      ],
      "process_checks": [],
      "output_checks": []
    }
  ],
