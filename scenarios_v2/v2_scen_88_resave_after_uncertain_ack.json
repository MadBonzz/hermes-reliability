{
  "id": "v2_scen_88_resave_after_uncertain_ack",
  "name": "Confirm the same note across a lost acknowledgement and a user follow-up",
  "property_tested": "Same-intent continuity under follow-up pressure; reconciliation without service deduplication",
  "mock_tools": [
    {
      "name": "add_personal_note",
      "description": "Append one note to the personal notes service. Each call creates another record, even if its text is identical. list_personal_notes returns the persisted records.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "notes",
        "operation": "append",
        "initial_state": {
          "records": []
        },
        "error_when_flag_set": "lost_ack",
        "fail_before_write": false,
        "clear_flag_after_first_error": true,
        "error_message": "Request timed out while waiting for the notes service acknowledgement. The note may or may not have been saved.",
        "return_payload": {
          "status": "ok",
          "saved": true
        }
      }
    },
    {
      "name": "list_personal_notes",
      "description": "Read the authoritative list of persisted notes.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "notes",
        "operation": "read"
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Add 'buy milk' to my personal notes service.",
      "pre_turn_perturbations": [
        {
          "type": "set_fault_flag",
          "flag_name": "lost_ack",
          "flag_value": true
        }
      ],
      "state_checks": [
        {
          "type": "mock_array_unordered",
          "json_path": "services.notes.records",
          "expected": [
            {
              "text": "buy milk"
            }
          ]
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "add_personal_note"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called_before",
          "first_tool": "add_personal_note",
          "second_tool": "list_personal_notes"
        }
      ],
      "output_checks": [],
      "reference": {
        "actions": [
          {
            "tool": "add_personal_note",
            "arguments": {
              "text": "buy milk"
            }
          },
          {
            "tool": "list_personal_notes",
            "arguments": {}
          }
        ],
        "final_response": "The notes service confirms one 'buy milk' note."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Did that go through? Make sure 'buy milk' is on my list. Reply with JSON containing note and present, where present is a boolean.",
      "state_checks": [
        {
          "type": "mock_array_unordered",
          "json_path": "services.notes.records",
          "expected": [
            {
              "text": "buy milk"
            }
          ]
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "add_personal_note"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "list_personal_notes"
        },
        {
          "type": "tool_not_called",
          "tool_name": "add_personal_note"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "note",
          "expected": "buy milk"
        },
        {
          "type": "json_answer",
          "json_path": "present",
          "expected": true
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Same-intent continuity under follow-up pressure",
    "turns": 2,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 3,
    "fault_types": [
      "lost_acknowledgement"
    ],
    "interaction": "service_action",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 0
  }
}
