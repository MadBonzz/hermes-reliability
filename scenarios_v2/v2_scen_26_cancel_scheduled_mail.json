{
  "id": "v2_scen_26_cancel_scheduled_mail",
  "name": "Cancel a queued announcement",
  "property_tested": "Cancellation semantics; external state verification",
  "mock_tools": [
    {
      "name": "schedule_announcement",
      "description": "Queue an announcement under job ID fair-1. Returns its status; it is not delivered during this session.",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "send_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "to",
          "body",
          "send_at"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "queue",
        "operation": "transition",
        "initial_state": {
          "status": "idle"
        },
        "requires": {
          "status": "idle"
        },
        "updates": {
          "status": "queued",
          "to": {
            "$arg": "to"
          },
          "body": {
            "$arg": "body"
          },
          "send_at": {
            "$arg": "send_at"
          }
        }
      }
    },
    {
      "name": "cancel_announcement",
      "description": "Cancel the queued announcement fair-1.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "queue",
        "operation": "transition",
        "requires": {
          "status": "queued"
        },
        "updates": {
          "status": "cancelled"
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please schedule the 'Spring fair' announcement to parents@example.test for 2026-11-20T15:00:00Z. The content is 'Registration opens Monday.'",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.queue.status",
          "expected": "queued"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.queue.to",
          "expected": "parents@example.test"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.queue.body",
          "expected": "Registration opens Monday."
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.queue.send_at",
          "expected": "2026-11-20T15:00:00Z"
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "schedule_announcement"
        }
      ],
      "output_checks": [],
      "reference": {
        "actions": [
          {
            "tool": "schedule_announcement",
            "arguments": {
              "to": "parents@example.test",
              "body": "Registration opens Monday.",
              "send_at": "2026-11-20T15:00:00Z"
            }
          }
        ],
        "final_response": "Completed the requested operation."
      }
    },
    {
      "turn_number": 2,
      "prompt": "The fair is postponed. Cancel that announcement; nobody should receive it.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.queue.status",
          "expected": "cancelled"
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "schedule_announcement",
            "cancel_announcement"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "cancel_announcement"
        }
      ],
      "output_checks": []
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Cancellation semantics",
    "turns": 2,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 2,
    "fault_types": [],
    "interaction": "mixed",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 0,
    "asserted_file_paths": 0
  }
}
