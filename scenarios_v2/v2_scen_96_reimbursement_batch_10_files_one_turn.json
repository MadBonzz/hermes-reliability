{
  "id": "v2_scen_96_reimbursement_batch_10_files_one_turn",
  "name": "Reimbursement Batch across 10 files and one turn",
  "property_tested": "reimbursement_batch",
  "benchmark_version": 2,
  "mock_tools": [
    {
      "name": "settle_reimbursement",
      "description": "Settle a reimbursement. request_id identifies the same logical payment across retries. Replays with identical arguments return the original receipt without another charge. Different arguments under the same ID are rejected. Successful replies include receipt_id.",
      "parameters": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "invoice_id",
          "recipient",
          "amount_usd",
          "request_id"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "settlements",
        "operation": "idempotent_append",
        "initial_state": {
          "records": []
        },
        "idempotency_field": "request_id",
        "receipt_prefix": "PAY",
        "error_when_flag_set": "lost_ack",
        "fail_before_write": false,
        "clear_flag_after_first_error": true,
        "error_message": "Connection closed before acknowledgement. Settlement outcome unknown.",
        "return_payload": {
          "status": "paid"
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Pay all approved reimbursements in {WORKSPACE}/invoices through the settlement service and bring their records up to date under payment_policy.json. Each invoice should be settled once.",
