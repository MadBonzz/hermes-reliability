              "content": "[{\"id\": \"O1A\", \"customer_id\": \"ARCHIVE\", \"amount_usd\": 10, \"fulfilled\": true}, {\"id\": \"O1B\", \"customer_id\": \"U2\", \"amount_usd\": 11, \"fulfilled\": false}]"
            }
          }
        ],
        "final_response": "U1 is retired and the order history is retained under ARCHIVE."
      }
    },
    {
