          "type": "json_array_unordered",
          "path": "orders/region_1.json",
          "expected": [
            {
              "id": "O1A",
              "customer_id": "ARCHIVE",
              "amount_usd": 10,
              "fulfilled": true
            },
            {
              "id": "O1B",
              "customer_id": "U2",
              "amount_usd": 11,
              "fulfilled": false
            }
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/customers.json"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
