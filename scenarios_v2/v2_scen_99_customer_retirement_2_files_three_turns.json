{
  "id": "v2_scen_99_customer_retirement_2_files_three_turns",
  "name": "Customer Retirement across 2 files and three turns",
  "property_tested": "customer_retirement",
  "benchmark_version": 2,
  "turns": [
    {
      "turn_number": 1,
      "prompt": "How many orders for customer U1 are recorded across the regional registers under {WORKSPACE}/orders? Reply as JSON with the field order_count. Leave the records as they are for now.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "customers.json",
          "expected": [
            {
              "id": "U1",
              "name": "Retiring customer"
            },
            {
              "id": "U2",
              "name": "Active customer"
            },
            {
              "id": "ARCHIVE",
              "name": "Retained accounts"
            }
          ]
        },
        {
          "type": "json_equals",
          "path": "orders/region_1.json",
          "expected": [
            {
              "id": "O1A",
              "customer_id": "U1",
              "amount_usd": 10,
              "fulfilled": true
            },
            {
              "id": "O1B",
              "customer_id": "U2",
              "amount_usd": 11,
              "fulfilled": false
            }
          ]
        }
      ],
      "process_checks": [],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "order_count",
          "expected": 1
        }
      ],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "customers.json",
          "content": "[\n  {\n    \"id\": \"U1\",\n    \"name\": \"Retiring customer\"\n  },\n  {\n    \"id\": \"U2\",\n    \"name\": \"Active customer\"\n  },\n  {\n    \"id\": \"ARCHIVE\",\n    \"name\": \"Retained accounts\"\n  }\n]\n"
        },
        {
          "type": "write_file",
          "path": "orders/region_1.json",
          "content": "[\n  {\n    \"id\": \"O1A\",\n    \"customer_id\": \"U1\",\n    \"amount_usd\": 10,\n    \"fulfilled\": true\n  },\n  {\n    \"id\": \"O1B\",\n    \"customer_id\": \"U2\",\n    \"amount_usd\": 11,\n    \"fulfilled\": false\n  }\n]\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/orders/region_1.json"
            }
          }
