{
  "id": "v2_scen_20_circuit_breaker_failover",
  "name": "Convert travel expenses while a rate feed is unavailable",
  "property_tested": "Service failover and reuse of outage knowledge",
  "mock_tools": [
    {
      "name": "fetch_fx_primary",
      "description": "Preferred EUR_USD exchange-rate feed. A 503 indicates it is unavailable for the rest of this session.",
      "parameters": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "string"
          }
        }
      },
      "behavior": {
        "type": "static_return",
        "error_when_flag_set": "primary_down",
        "error_message": "503 Service Unavailable: Primary FX endpoint is offline.",
        "return_payload": {
          "pair": "EUR_USD",
          "rate": 1.1
        }
      }
    },
    {
      "name": "fetch_fx_backup",
      "description": "Backup EUR_USD feed with the same rate definition and freshness as the primary.",
      "parameters": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "string"
          }
        }
      },
      "behavior": {
        "type": "static_return",
        "return_payload": {
          "pair": "EUR_USD",
          "rate": 1.1
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please get the current EUR_USD rate from our rate service and save pair and rate in {WORKSPACE}/exchange_rate.json.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "exchange_rate.json",
          "json_path": "pair",
          "expected": "EUR_USD"
        },
        {
          "type": "json_equals",
          "path": "exchange_rate.json",
          "json_path": "rate",
          "expected": 1.1
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "fetch_fx_primary"
        }
      ],
      "output_checks": [],
      "reference": {
        "actions": [
          {
            "tool": "fetch_fx_primary",
            "arguments": {
              "pair": "EUR_USD"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/exchange_rate.json",
              "content": "{\n  \"pair\": \"EUR_USD\",\n  \"rate\": 1.1\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 2,
      "prompt": "Convert a 100 EUR travel expense at the current rate. Save amount_usd and rate in expense_1.json.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "expense_1.json",
          "json_path": "amount_usd",
          "expected": 110
        },
        {
          "type": "json_equals",
          "path": "expense_1.json",
          "json_path": "rate",
          "expected": 1.1
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "fetch_fx_primary"
        },
        {
          "type": "tool_called",
          "tool_name": "fetch_fx_backup"
        }
      ],
      "output_checks": [],
      "pre_turn_perturbations": [
        {
          "type": "set_fault_flag",
          "flag_name": "primary_down",
          "flag_value": true
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/exchange_rate.json"
            }
          },
          {
            "tool": "fetch_fx_primary",
            "arguments": {
              "pair": "EUR_USD"
            }
          },
          {
            "tool": "fetch_fx_backup",
            "arguments": {
              "pair": "EUR_USD"
            }
          },
          {
            "tool": "write_file",
            "arguments": {
              "path": "{WORKSPACE}/expense_1.json",
              "content": "{\n  \"amount_usd\": 110,\n  \"rate\": 1.1\n}\n"
            }
          }
        ],
        "final_response": "Completed the requested update."
      }
    },
    {
      "turn_number": 3,
      "prompt": "There's another expense of 200 EUR. Please convert it at the current rate into expense_2.json with the same fields.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "expense_2.json",
          "json_path": "amount_usd",
          "expected": 220
        },
        {
          "type": "json_equals",
          "path": "expense_2.json",
          "json_path": "rate",
          "expected": 1.1
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "fetch_fx_backup"
        },
        {
          "type": "tool_not_called",
          "tool_name": "fetch_fx_primary"
        }
      ],
      "output_checks": []
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Service failover and reuse of outage knowledge",
    "turns": 3,
    "input_files": 0,
    "services": 2,
    "records": 0,
    "dependency_depth": 3,
    "fault_types": [
      "primary_outage"
    ],
    "interaction": "mixed",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 3
  }
}
