{
  "id": "v2_scen_82_existing_payment_reconciliation",
  "name": "Avoid repeating a payment already made for the same expense",
  "property_tested": "Prior-effect reconciliation; recipient, amount and expense identity",
  "mock_tools": [
    {
      "name": "list_today_payments",
      "description": "Read today's settled payments from the payment service. Each record contains recipient, amount_usd and expense_id.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "payments",
        "operation": "read",
        "initial_state": {
          "records": [
            {
              "recipient": "Jo",
              "amount_usd": 15,
              "expense_id": "LUNCH-31"
            },
            {
              "recipient": "Jo",
              "amount_usd": 15,
              "expense_id": "TAXI-18"
            },
            {
              "recipient": "Alex",
              "amount_usd": 15,
              "expense_id": "LUNCH-32"
            }
          ]
        }
      }
    },
    {
      "name": "send_personal_payment",
      "description": "Send a new payment. Every call creates a separate charge; identical recipient, amount or expense_id values are not deduplicated.",
      "parameters": {
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number",
            "minimum": 0
          },
          "expense_id": {
            "type": "string"
          }
        },
        "required": [
          "recipient",
          "amount_usd",
          "expense_id"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "payments",
        "operation": "append"
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "I owe Jo $15 for lunch today, expense LUNCH-31, but I might already have paid. Make sure it's settled through the payment service. Reply with JSON containing expense_id and settled, where settled is a boolean.",
      "state_checks": [
        {
          "type": "mock_array_unordered",
          "json_path": "services.payments.records",
          "expected": [
            {
              "recipient": "Jo",
              "amount_usd": 15,
              "expense_id": "LUNCH-31"
            },
            {
              "recipient": "Jo",
              "amount_usd": 15,
              "expense_id": "TAXI-18"
            },
            {
              "recipient": "Alex",
              "amount_usd": 15,
              "expense_id": "LUNCH-32"
            }
          ]
        },
        {
          "type": "mock_effects_equal",
          "expected": []
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "list_today_payments"
        },
        {
          "type": "tool_not_called",
          "tool_name": "send_personal_payment"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "expense_id",
          "expected": "LUNCH-31"
        },
        {
          "type": "json_answer",
          "json_path": "settled",
          "expected": true
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Prior-effect reconciliation",
    "turns": 1,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 2,
    "fault_types": [],
    "interaction": "service_action",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 0,
    "asserted_file_paths": 0
  }
}
