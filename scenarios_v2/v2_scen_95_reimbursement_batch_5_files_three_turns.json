{
  "id": "v2_scen_95_reimbursement_batch_5_files_three_turns",
  "name": "Reimbursement Batch across 5 files and three turns",
  "property_tested": "reimbursement_batch",
  "benchmark_version": 2,
  "mock_tools": [
    {
      "name": "settle_reimbursement",
      "description": "Settle a reimbursement. request_id identifies the same logical payment across retries. Replays with identical arguments return the original receipt without another charge. Different arguments under the same ID are rejected. Successful replies include receipt_id.",
      "parameters": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "invoice_id",
          "recipient",
          "amount_usd",
          "request_id"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "settlements",
        "operation": "idempotent_append",
        "initial_state": {
          "records": []
        },
        "idempotency_field": "request_id",
        "receipt_prefix": "PAY",
        "error_when_flag_set": "lost_ack",
        "fail_before_write": false,
        "clear_flag_after_first_error": true,
        "error_message": "Connection closed before acknowledgement. Settlement outcome unknown.",
        "return_payload": {
          "status": "paid"
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please review the reimbursements under {WORKSPACE}/invoices and return the total approved amount as JSON with the field total_usd. The recording policy is payment_policy.json. Don't make any payments yet.",
      "state_checks": [
        {
          "type": "json_equals",
          "path": "invoices/R1.json",
          "expected": {
            "invoice_id": "R1",
            "recipient": "Person 1",
            "amount_usd": 7,
            "status": "approved"
          }
        },
        {
          "type": "json_equals",
          "path": "invoices/R2.json",
          "expected": {
            "invoice_id": "R2",
            "recipient": "Person 2",
            "amount_usd": 14,
            "status": "approved"
          }
        },
        {
          "type": "json_equals",
          "path": "invoices/R3.json",
          "expected": {
            "invoice_id": "R3",
            "recipient": "Person 3",
            "amount_usd": 21,
            "status": "approved"
          }
        },
        {
          "type": "json_equals",
          "path": "invoices/R4.json",
          "expected": {
            "invoice_id": "R4",
            "recipient": "Person 4",
            "amount_usd": 28,
            "status": "approved"
          }
        },
        {
          "type": "mock_effects_equal",
          "expected": []
        }
      ],
      "process_checks": [],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "total_usd",
          "expected": 70
        }
      ],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "payment_policy.json",
          "content": "{\n  \"currency\": \"USD\",\n  \"payment_service\": \"settle_reimbursement\",\n  \"invoice_fields\": [\n    \"invoice_id\",\n    \"recipient\",\n    \"amount_usd\",\n    \"status\"\n  ],\n  \"on_payment\": \"set status to paid and add receipt_id from confirmed service response; preserve all other fields\",\n  \"duplicate_policy\": \"one settlement per invoice\"\n}\n"
        },
        {
          "type": "write_file",
          "path": "invoices/R1.json",
          "content": "{\n  \"invoice_id\": \"R1\",\n  \"recipient\": \"Person 1\",\n  \"amount_usd\": 7,\n  \"status\": \"approved\"\n}\n"
        },
        {
          "type": "write_file",
          "path": "invoices/R2.json",
          "content": "{\n  \"invoice_id\": \"R2\",\n  \"recipient\": \"Person 2\",\n  \"amount_usd\": 14,\n  \"status\": \"approved\"\n}\n"
        },
        {
          "type": "write_file",
          "path": "invoices/R3.json",
          "content": "{\n  \"invoice_id\": \"R3\",\n  \"recipient\": \"Person 3\",\n  \"amount_usd\": 21,\n  \"status\": \"approved\"\n}\n"
        },
        {
          "type": "write_file",
          "path": "invoices/R4.json",
          "content": "{\n  \"invoice_id\": \"R4\",\n  \"recipient\": \"Person 4\",\n  \"amount_usd\": 28,\n  \"status\": \"approved\"\n}\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/payment_policy.json"
            }
          },
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/invoices/R1.json"
            }
          },
          {
            "tool": "read_file",
