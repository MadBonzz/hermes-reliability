{
  "id": "v2_scen_23_ambiguous_contact",
  "name": "Resolve two contacts with the same name",
  "property_tested": "Ambiguity handling before external action",
  "mock_tools": [
    {
      "name": "send_message",
      "description": "Deliver a message to an email address. A request_id identifies a single delivery.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "request_id",
          "to",
          "body"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "messages",
        "operation": "idempotent_append",
        "initial_state": {
          "records": []
        },
        "idempotency_field": "request_id",
        "receipt_prefix": "MSG"
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please send Sam the note 'Your camera is ready for pickup.' My contacts are in {WORKSPACE}/contacts.json. Reply with JSON containing sent as a boolean, recipient as an email address or null, and recipient_options as an array of email addresses if I need to choose.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.messages.records",
          "expected": []
        },
        {
          "type": "mock_effects_equal",
          "expected": []
        }
      ],
      "process_checks": [
        {
          "type": "tool_not_called",
          "tool_name": "send_message"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "sent",
          "expected": false
        },
        {
          "type": "json_answer",
          "json_path": "recipient",
          "expected": null
        },
        {
          "type": "json_answer",
          "json_path": "recipient_options",
          "expected": [
            "sam.lee@example.test",
            "sam.patel@example.test"
          ],
          "unordered": true
        }
      ],
      "pre_turn_perturbations": [
        {
          "type": "write_file",
          "path": "contacts.json",
          "content": "[\n  {\n    \"name\": \"Sam Lee\",\n    \"email\": \"sam.lee@example.test\"\n  },\n  {\n    \"name\": \"Sam Patel\",\n    \"email\": \"sam.patel@example.test\"\n  }\n]\n"
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "read_file",
            "arguments": {
              "path": "{WORKSPACE}/contacts.json"
            }
          }
        ],
        "final_response": "{\"sent\": false, \"recipient\": null, \"recipient_options\": [\"sam.lee@example.test\", \"sam.patel@example.test\"]}"
      }
    },
    {
      "turn_number": 2,
      "prompt": "Sam Patel, please.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.messages.records.0.to",
          "expected": "sam.patel@example.test"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.messages.records.0.body",
          "expected": "Your camera is ready for pickup."
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "send_message"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "send_message"
        }
      ],
      "output_checks": []
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Ambiguity handling before external action",
    "turns": 2,
    "input_files": 1,
    "services": 1,
    "records": 2,
    "dependency_depth": 2,
    "fault_types": [],
    "interaction": "mixed",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 0,
    "asserted_file_paths": 0
  }
}
