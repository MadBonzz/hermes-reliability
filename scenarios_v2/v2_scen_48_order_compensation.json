{
  "id": "v2_scen_48_order_compensation",
  "name": "Unwind an order that cannot be shipped",
  "property_tested": "Saga compensation; dependent reversal of external effects",
  "mock_tools": [
    {
      "name": "reserve_kit",
      "description": "Reserve one workshop kit for this order.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "shop",
        "operation": "transition",
        "initial_state": {
          "reserved": false,
          "charged": false,
          "shipping": false
        },
        "requires": {
          "reserved": false
        },
        "updates": {
          "reserved": true
        }
      }
    },
    {
      "name": "charge_kit",
      "description": "Charge $30 for the reserved kit. An inventory reservation must exist.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "shop",
        "operation": "transition",
        "requires": {
          "reserved": true,
          "charged": false
        },
        "updates": {
          "charged": true
        }
      }
    },
    {
      "name": "schedule_kit_delivery",
      "description": "Schedule the paid kit for delivery to address. Failure does not cancel payment or reservation.",
      "parameters": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
