        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "shop",
        "operation": "transition",
        "requires": {
          "reserved": true,
          "charged": true
        },
        "updates": {
          "shipping": true
        },
        "error_when_flag_set": "shipping_down",
        "error_message": "No delivery service is available for this order."
      }
    },
    {
      "name": "refund_kit",
      "description": "Refund the kit charge when shipping has not been scheduled.",
      "parameters": {
