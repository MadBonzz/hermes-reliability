        "type": "stateful_service",
        "service": "shop",
        "operation": "transition",
        "requires": {
          "charged": true,
          "shipping": false
        },
        "updates": {
          "charged": false
        }
      }
    },
    {
      "name": "release_kit",
      "description": "Release an unpaid reservation; paid reservations must be refunded before release.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "shop",
        "operation": "transition",
        "requires": {
          "reserved": true,
          "charged": false
        },
        "updates": {
          "reserved": false
        }
      }
