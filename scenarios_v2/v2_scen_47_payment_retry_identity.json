{
  "id": "v2_scen_47_payment_retry_identity",
  "name": "Pay an invoice despite a lost acknowledgement",
  "property_tested": "Idempotency-key continuity; distinct repeated business intent",
  "mock_tools": [
    {
      "name": "pay_invoice",
      "description": "Pay an invoice. request_id identifies one logical payment across transport retries. Reuse of the same ID and identical parameters returns the original receipt; different parameters under the same ID are rejected. A successful response includes a receipt_id unique to that payment.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "invoice_id": {
            "type": "string",
            "minLength": 1
          },
          "amount_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "request_id",
          "invoice_id",
          "amount_usd"
        ],
        "additionalProperties": false
      },
      "behavior": {
        "type": "stateful_service",
        "service": "payments",
        "operation": "idempotent_append",
        "initial_state": {
          "records": []
        },
        "idempotency_field": "request_id",
        "receipt_prefix": "PAY",
        "error_when_flag_set": "lost_receipt",
        "error_message": "502 Bad Gateway: connection lost while receiving payment acknowledgement; outcome unknown.",
        "fail_before_write": false,
        "clear_flag_after_first_error": true,
        "return_payload": {
          "status": "ok"
        }
      }
    }
  ],
  "turns": [
    {
      "turn_number": 1,
      "prompt": "Please pay invoice INV-A for $25 and give me the receipt ID. Reply with JSON containing receipt_id.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.0.invoice_id",
          "expected": "INV-A"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.0.amount_usd",
          "expected": 25
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "pay_invoice"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "min_tool_call_count",
          "tool_name": "pay_invoice",
          "count": 2
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "receipt_id",
          "expected": "PAY-000001"
        }
      ],
      "pre_turn_perturbations": [
        {
          "type": "set_fault_flag",
          "flag_name": "lost_receipt",
          "flag_value": true
        }
      ],
      "reference": {
        "actions": [
          {
            "tool": "pay_invoice",
            "arguments": {
              "request_id": "invoice-a-payment",
              "invoice_id": "INV-A",
              "amount_usd": 25
            }
          },
          {
            "tool": "pay_invoice",
            "arguments": {
              "request_id": "invoice-a-payment",
              "invoice_id": "INV-A",
              "amount_usd": 25
            }
          }
        ],
        "final_response": "{\"receipt_id\": \"PAY-000001\"}"
      }
    },
    {
      "turn_number": 2,
      "prompt": "Please pay invoice INV-B for $25 and give me the receipt ID. Reply with JSON containing receipt_id.",
      "state_checks": [
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.1.invoice_id",
          "expected": "INV-B"
        },
        {
          "type": "mock_state_equals",
          "json_path": "services.payments.records.1.amount_usd",
          "expected": 25
        },
        {
          "type": "mock_effects_equal",
          "expected": [
            "pay_invoice",
            "pay_invoice"
          ]
        }
      ],
      "process_checks": [
        {
          "type": "tool_called",
          "tool_name": "pay_invoice"
        }
      ],
      "output_checks": [
        {
          "type": "json_answer",
          "json_path": "receipt_id",
          "expected": "PAY-000002"
        }
      ]
    }
  ],
  "benchmark_version": 2,
  "complexity": {
    "family": "Idempotency-key continuity",
    "turns": 2,
    "input_files": 0,
    "services": 1,
    "records": 0,
    "dependency_depth": 3,
    "fault_types": [
      "lost_acknowledgement"
    ],
    "interaction": "service_action",
    "notes": "Authored depth estimates count dependent reasoning/action stages, not tool calls. Fault count counts adverse episodes, including supplied bad data and context loss; fixtures and user revisions alone are excluded. Input files count distinct fixture paths.",
    "fault_count": 1,
    "asserted_file_paths": 0
  }
}
